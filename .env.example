# Copy this file to .env and fill in your tokens. Never commit .env.
# Used by publish scripts and by the bot when running cargo publish, maturin publish, npm publish.
# .env is gitignored.

# crates.io: create token at https://crates.io/settings/tokens
# Bot/script: run `cargo login --token $CARGO_REGISTRY_TOKEN` before cargo publish
# CARGO_REGISTRY_TOKEN=

# PyPI: create project-scoped token at https://pypi.org/manage/account/token/
# PYPI_API_TOKEN=

# npm (local CLI and GitHub Actions secret NPM_TOKEN):
# Publishing often returns E403 until npm security rules are satisfied:
# - Use a Granular Access Token: https://www.npmjs.com/settings/~/tokens -> Generate New Token -> Granular.
#   Pick package uniworld (or All). Permissions: Read and Write. Use for CI/automation as npm directs.
# - If npm requires 2FA to publish, enable 2FA on the account and/or use a token type that can publish
#   from CI (npm documents "automation" / bypass where applicable).
# Put the same token value in GitHub repo Settings -> Secrets -> NPM_TOKEN for release.yml.
# NPM_TOKEN=

# VS Code Marketplace: create a Personal Access Token (PAT) at https://dev.azure.com
#   Organization: select your org (or "All accessible organizations")
#   Scopes: Marketplace > Manage
# Used by: vsce publish (or via CI)
# VSCE_PAT=

# PowerShell Gallery: create an API key at https://www.powershellgallery.com/account/apikeys
# Used by: Publish-Module -NuGetApiKey $env:PSGALLERY_API_KEY
# PSGALLERY_API_KEY=
